PORT=4000
FRONTEND_URL=http://localhost:3000
# This API's public URL, used by OAuth/MCP clients (https in production)
PUBLIC_API_URL=http://localhost:4000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@host:6543/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=replace-with-a-long-random-string
# Free key from https://aistudio.google.com (no credit card). Leave unset to disable AI features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
