generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  oauthGrants   OAuthGrant[]
  oauthTokens   OAuthToken[]
  draftHandoffs DraftHandoff[]
}

model Post {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String
  excerpt    String
  authorId   String
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    Like[]
  chunks   PostChunk[]

  @@index([authorId])
  @@index([categoryId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts Post[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  postId    String
  authorId  String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Like {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

// A slice of a post's text plus its embedding: the "meaning as numbers" used by semantic search.
// Prisma can't read or write the pgvector type, so this table is accessed with raw SQL
// (see post-chunk.repository.ts). 768 must match EMBEDDING_DIMENSIONS in src/ai/ai-provider.ts.
model PostChunk {
  id         String                     @id
  postId     String
  chunkIndex Int
  content    String
  embedding  Unsupported("vector(768)")
  createdAt  DateTime                   @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, chunkIndex])
}

// --- Remote MCP server: OAuth 2.1 (step 7) --------------------------------------------------

// An app (Claude, ChatGPT, ...) that registered itself through OAuth dynamic client registration.
model OAuthClient {
  id        String   @id
  // The full registration (name, redirect URIs, ...) as the client sent it.
  metadata  Json
  createdAt DateTime @default(now())

  grants OAuthGrant[]
  tokens OAuthToken[]
}

// One "may this app access your blog?" request. Created when the app starts the OAuth flow,
// approved by the user on the consent page, then exchanged (once) for tokens.
model OAuthGrant {
  id            String   @id @default(cuid())
  clientId      String
  redirectUri   String
  codeChallenge String
  state         String?
  scopes        String[]
  resource      String?
  status        String   @default("pending") // pending | approved | denied | used
  userId        String?
  // Only a hash of the authorization code is stored, like a password.
  codeHash      String?  @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Access and refresh tokens, stored as SHA-256 hashes: a database leak doesn't leak tokens.
model OAuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  kind      String // access | refresh
  clientId  String
  userId    String
  scopes    String[]
  resource  String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A draft an AI app prepared, waiting for its owner to review and publish on the website.
model DraftHandoff {
  id        String   @id @default(cuid())
  userId    String
  draft     Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
